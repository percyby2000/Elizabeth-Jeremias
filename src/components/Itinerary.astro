---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Italiana&display=swap" rel="stylesheet" />

<section class="schedule" id="itinerario">
  <h2 class="schedule__title reveal">Itinerario</h2>

  <ul class="schedule__list">
    {items.map((item, i) => (
      <li class={`schedule__row reveal reveal-delay-${Math.min(i + 1, 4)}`}>
        <span class="schedule__icon" set:html={item.icon} />
        <span class="schedule__time">{item.time}</span>
        <span class="schedule__dash" aria-hidden="true"></span>
        <span class="schedule__label">{item.label}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .schedule {
    --it-bg: var(--terracota, #9e4922);
    padding-block: clamp(3rem, 6vw, 4.5rem);
    padding-inline: 1.25rem;
    background-color: var(--it-bg);
    color: #fff;
  }

  .schedule__title {
    margin: 0 0 1.6rem;
    text-align: center;
    font-family: var(--font-display, 'Italiana', serif);
    font-weight: 400;
    font-size: clamp(2.2rem, 4vw, 3rem);
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .schedule__list {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    width: fit-content;
  }

  .schedule__row {
    display: grid;
    grid-template-columns: 3.6rem 6.6rem 2.6rem 8.4rem;
    align-items: center;
    column-gap: 1.5rem;
    min-height: 5.6rem;
    font-family: var(--font-body, Georgia, serif);
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    line-height: 1.25;
  }

  .schedule__icon {
    display: flex;
    justify-content: center;
    color: #fff;
  }
  .schedule__icon :global(svg) {
    width: 3.1rem;
    height: 3.1rem;
  }

  .schedule__dash {
    display: block;
    height: 2px;
    background: #fff;
  }

  /* ---------- Móvil ---------- */
  @media (max-width: 480px) {
    .schedule__row {
      grid-template-columns: 2.8rem 5.6rem 1.8rem 7rem;
      column-gap: 0.9rem;
      min-height: 5rem;
      font-size: 0.95rem;
    }
    .schedule__icon :global(svg) {
      width: 2.6rem;
      height: 2.6rem;
    }
  }
</style>