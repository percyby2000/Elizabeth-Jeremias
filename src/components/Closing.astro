---

<footer class="closing" id="cierre">
  <p><a href="https://github.com/percyby2000" target="_blank" rel="noopener noreferrer">Hecho con &#x2665; por Percy</a></p>

</footer>


<style>
  .closing {
    min-height: 4.2rem;
    display: grid;
    place-items: center;
    padding: 1rem 1.5rem;
    background: var(--terracota);
    text-align: center;
  }
  .closing p {
    font-family: Arial, sans-serif;
    font-style: italic;
    font-size: 0.85rem;
    color: #fff;
    letter-spacing: 0.06em;
  }
  .closing a {
    color: #fff;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .closing a:hover {
    opacity: 0.75;
  }
  @media (max-width: 600px) {
    .closing {
      place-items: center start;
      text-align: left;
    }
  }
</style>
