---
// Código de vestimenta

// Edita estos datos:
const FOTO = '/img/fondo1.jpg';
const ESTILO = 'Formal';
const MUJERES = 'Vestido Formal (Largo)';
const HOMBRES = 'Traje Formal';
const NOTA = 'Reservamos los colores blanco y terracota para la novia y damas de honor.';
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Italiana&display=swap" rel="stylesheet" />

<section class="dress" id="vestimenta">
  <!-- Flor -->
  <div class="dress__flower" aria-hidden="true">
    <img src="/img/florisquierda.png" alt="" loading="lazy" />
  </div>

  <!-- Foto con marco -->
  <div class="dress__photo reveal">
    <div class="dress__frame">
      <img src={FOTO} alt="Elizabeth y Jeremias" loading="lazy" />
    </div>
  </div>

  <!-- Texto -->
  <div class="dress__content">
    <svg class="dress__icon reveal" viewBox="0 0 48 52" aria-hidden="true">
      <!-- vestido -->
      <path d="M7 3 L10.5 3 L11.5 8 L12.5 17 L19 49 L1 49 L7.5 17 L8.5 8 Z" />
      <!-- traje -->
      <path d="M30 3 L33.5 9 L37 3 L42 5 L43.5 26 L40 26 L40 49 L35 49 L33.5 31 L32 49 L27 49 L27 26 L23.5 26 L25 5 Z" />
      <path class="dress__cut" d="M33.5 9 L33.5 24" />
    </svg>

    <h2 class="dress__title reveal reveal-delay-1">Código de vestimenta</h2>
    <p class="dress__style reveal reveal-delay-1">{ESTILO}</p>

    <p class="dress__line reveal reveal-delay-2"><b>Mujeres:</b> {MUJERES}</p>
    <p class="dress__line reveal reveal-delay-2"><b>Hombres:</b> {HOMBRES}</p>
    <p class="dress__line dress__note reveal reveal-delay-3">{NOTA}</p>

    <div class="dress__colors reveal reveal-delay-3" aria-label="Colores reservados: blanco y terracota">
      <span class="dress__dot dress__dot--white"></span>
      <span class="dress__dot dress__dot--terra"></span>
    </div>
  </div>
</section>

<style>
  .dress {
    /* Encuadre de la foto (X% Y%). Ajusta si cortan a la pareja */
    --foco: 50% 40%;

    --d-accent: var(--terracota, #9e4922);
    --d-brown: #5e3320;
    --d-ink: #1f1511;
    --d-bg: var(--cream, #ebe3da);

    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    padding-block: clamp(3.5rem, 6vw, 4rem);
    background: var(--d-bg);
  }

  /* ---------- Flor ---------- */
  .dress__flower {
    position: absolute;
    top: 0;
    right: 0;
    width: clamp(120px, 15vw, 290px);
    pointer-events: none;
    transform: scaleX(-1);
  }
  .dress__flower img { display: block; width: 100%; height: auto; }

  /* ---------- Foto ---------- */
  .dress__photo {
    display: flex;
    justify-content: center;
    padding-inline: 1.5rem;
  }
  .dress__frame {
    width: min(100%, 592px);
    aspect-ratio: 592 / 668;
    padding: 5px;
    border: 1px solid var(--d-brown);
  }
  .dress__frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--foco);
  }

  /* ---------- Texto ---------- */
  .dress__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 480px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .dress__icon {
    width: 2.6rem;
    height: auto;
    fill: var(--d-brown);
    margin-bottom: 1.1rem;
  }
  .dress__icon .dress__cut {
    fill: none;
    stroke: var(--d-bg);
    stroke-width: 1.2;
  }

  .dress__title {
    margin: 0;
    font-family: var(--font-display, 'Italiana', serif);
    font-weight: 400;
    font-size: clamp(2rem, 3.1vw, 2.8rem);
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--d-accent);
  }

  .dress__style {
    margin: 1.3rem 0 0;
    font-family: var(--font-body, Georgia, serif);
    font-size: 1rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--d-brown);
  }

  .dress__line {
    margin: 1.6rem 0 0;
    font-family: var(--font-body, Georgia, serif);
    font-size: clamp(1rem, 1.3vw, 1.1rem);
    letter-spacing: 0.05em;
    line-height: 1.45;
    color: var(--d-ink);
  }
  .dress__line b { font-weight: 700; }
  .dress__style + .dress__line { margin-top: 2rem; }
  .dress__note { max-width: 440px; }

  .dress__colors {
    display: flex;
    gap: 0.8rem;
    margin-top: 1.6rem;
  }
  .dress__dot {
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
  }
  .dress__dot--white { background: #fff; }
  .dress__dot--terra { background: var(--d-accent); }

  /* ---------- Móvil: foto arriba, texto abajo ---------- */
  @media (max-width: 800px) {
    .dress {
      grid-template-columns: 1fr;
      gap: 2.6rem;
      padding-block: 3rem 3.5rem;
    }
    .dress__flower { width: 110px; }
    .dress__frame { max-width: 400px; }
  }
</style>