---
// Hero Section — Elizabeth & Jeremias, boda 12 de diciembre de 2026
export interface Props {
  guestName?: string;
}
const { guestName = 'Familia Torres' } = Astro.props;
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Josefin+Sans:wght@300;400&display=swap"
  rel="stylesheet"
/>

<section class="hero" id="inicio">
  <div class="hero__bg">
    <img
      src="/img/fondo1.jpg"
      alt="Elizabeth y Jeremias"
      class="hero__photo"
      fetchpriority="high"
    />
  </div>

  <div class="hero__content">
    <p class="hero__eyebrow reveal">Nos casamos</p>

    <h1 class="hero__names reveal reveal-delay-1">
      <span class="hero__name">Elizabeth</span>
      <span class="hero__name"><em class="hero__y">y</em> Jeremias</span>
    </h1>

    <p class="hero__date reveal reveal-delay-2">12-12-2026</p>
  </div>

  <a href="#bienvenida" class="hero__scroll reveal reveal-delay-3" aria-label="Continuar">↓</a>
</section>

<style>
  .hero {
    /* Encuadre de la foto (X% Y%). Ajusta si cortan a la pareja */
    --foco: 40% 50%;
    --h-dark: #20110a;
    --h-cream: #f6efe4;

    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    overflow: hidden;
    background: var(--h-dark);
    color: var(--h-cream);
  }

  /* ---------- Foto + degradado hacia la derecha ---------- */
  .hero__bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .hero__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(32, 17, 10, 0) 30%,
      rgba(32, 17, 10, 0.75) 62%,
      rgba(32, 17, 10, 0.96) 100%
    );
  }
  .hero__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--foco);
    transform: scale(1.03);
    animation: hero-zoom 26s ease-in-out infinite alternate;
  }
  @keyframes hero-zoom {
    from { transform: scale(1.03); }
    to   { transform: scale(1.09); }
  }

  /* ---------- Texto ---------- */
  .hero__content {
    position: relative;
    z-index: 2;
    width: min(42%, 600px);
    margin-right: clamp(2rem, 7vw, 8rem);
    padding: 3rem 0;
  }

  .hero__eyebrow {
    margin: 0 0 1.2rem;
    font-family: 'Josefin Sans', sans-serif;
    font-weight: 300;
    font-size: 0.78rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .hero__names {
    margin: 0;
    display: flex;
    flex-direction: column;
    font-family: 'Cormorant Garamond', serif;
    font-weight: 500;
    line-height: 0.95;
  }
  .hero__name {
    font-size: clamp(3.4rem, 6.6vw, 6.4rem);
    letter-spacing: -0.015em;
  }
  .hero__y {
    font-weight: 400;
    font-size: 0.55em;
    opacity: 0.8;
    margin-right: 0.1em;
  }

  .hero__date {
    margin: 1.8rem 0 0;
    font-family: 'Josefin Sans', sans-serif;
    font-weight: 300;
    font-size: clamp(0.8rem, 1.1vw, 0.95rem);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  /* ---------- Flecha ---------- */
  .hero__scroll {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: 1.4rem;
    transform: translateX(-50%);
    color: var(--h-cream);
    text-decoration: none;
    font-size: 1.4rem;
    opacity: 0.7;
    animation: hero-bob 2.4s ease-in-out infinite;
  }
  @keyframes hero-bob {
    0%, 100% { transform: translate(-50%, 0); }
    50%      { transform: translate(-50%, 6px); }
  }

  /* ---------- Tablet ---------- */
  @media (max-width: 1024px) {
    .hero__content {
      width: min(50%, 460px);
      margin-right: 4vw;
    }
  }

  /* ---------- Móvil: foto arriba, texto abajo ---------- */
  @media (max-width: 768px) {
    .hero {
      flex-direction: column;
      justify-content: flex-end;
      align-items: stretch;
    }

    .hero__bg {
      bottom: auto;
      height: 72svh;
      -webkit-mask-image: linear-gradient(to bottom, #000 58%, transparent 100%);
              mask-image: linear-gradient(to bottom, #000 58%, transparent 100%);
    }
    .hero__bg::after { display: none; }
    .hero__photo { object-position: 45% 40%; }

    .hero__content {
      width: 100%;
      margin: 0;
      padding: 0 1.5rem 4.2rem;
      text-align: center;
    }
    .hero__eyebrow {
      font-size: 0.68rem;
      margin-bottom: 0.8rem;
    }
    .hero__names { align-items: center; }
    .hero__name { font-size: clamp(3.2rem, 15.5vw, 4.4rem); }
    .hero__date {
      margin-top: 1.2rem;
      font-size: 0.72rem;
      letter-spacing: 0.26em;
    }
    .hero__scroll { bottom: 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__photo,
    .hero__scroll { animation: none; }
  }
</style>