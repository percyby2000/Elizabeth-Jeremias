---
// Hero Section — Elizabeth & Jeremias, boda 12 de diciembre de 2026
export interface Props {
  guestName?: string;
}
const { guestName = 'Familia Torres' } = Astro.props;
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Josefin+Sans:wght@300;400;600&family=Playfair+Display:ital,wght@1,400;1,500&display=swap"
  rel="stylesheet"
/>

<section class="hero" id="inicio">
  <div class="hero__bg">
    <img
      src="/img/fondo1.jpg"
      alt="Elizabeth y Jeremias"
      class="hero__photo"
      fetchpriority="high"
    />
  </div>

  <!-- Móvil: "Nos casamos" fijo arriba de la foto -->
  <p class="hero__eyebrow-top reveal" aria-hidden="true">Nos casamos</p>

  <div class="hero__content">
    <!-- Escritorio: "Nos casamos" sobre los nombres -->
    <p class="hero__eyebrow reveal">Nos casamos</p>

    <h1 class="hero__names reveal reveal-delay-1">
      <span class="hero__name">Elizabeth</span>
      <span class="hero__amp" aria-hidden="true">&amp;</span>
      <span class="hero__name">Jeremias</span>
    </h1>

    <p class="hero__date reveal reveal-delay-2">12-12-2026</p>
  </div>

  <a href="#bienvenida" class="hero__scroll reveal reveal-delay-3" aria-label="Continuar">↓</a>
</section>

<style>
  .hero {
    /* Encuadre de la foto (X% Y%). Ajusta si cortan a la pareja */
    --foco: 40% 50%;

    --h-dark: #20110a;
    --h-cream: #f6efe4;
    --h-serif: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    --h-amp: 'Playfair Display', 'Cormorant Garamond', Georgia, serif;
    --h-sans: 'Josefin Sans', 'Helvetica Neue', Arial, sans-serif;

    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    overflow: hidden;
    background: var(--h-dark);
    color: var(--h-cream);
  }

  /* ---------- Foto + degradado hacia la derecha ---------- */
  .hero__bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .hero__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(32, 17, 10, 0) 32%,
      rgba(32, 17, 10, 0.62) 62%,
      rgba(32, 17, 10, 0.9) 100%
    );
  }
  .hero__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--foco);
    transform: scale(1.03);
    animation: hero-zoom 26s ease-in-out infinite alternate;
  }
  @keyframes hero-zoom {
    from { transform: scale(1.03); }
    to   { transform: scale(1.09); }
  }

  /* ---------- Texto (escritorio: centrado en la zona oscura) ---------- */
  .hero__content {
    position: relative;
    z-index: 2;
    width: min(40%, 560px);
    margin-right: clamp(2rem, 8vw, 9rem);
    padding: 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero__eyebrow {
    margin: 0 0 1.4rem;
    font-family: var(--h-sans);
    font-weight: 300;
    font-size: 0.8rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  /* Solo móvil */
  .hero__eyebrow-top { display: none; }

  .hero__names {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: var(--h-serif);
    font-weight: 500;
    line-height: 1;
  }
  .hero__name {
    font-size: clamp(3.2rem, 5.6vw, 5.6rem);
    letter-spacing: 0.005em;
  }

  /* El "&" adornado en cursiva */
  .hero__amp {
    display: block;
    font-family: var(--h-amp);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2.4rem, 4vw, 3.8rem);
    line-height: 1.05;
    margin-block: 0.05em;
    color: var(--h-cream);
    opacity: 0.95;
  }

  .hero__date {
    margin: 2rem 0 0;
    font-family: var(--h-sans);
    font-weight: 300;
    font-size: clamp(0.9rem, 1.3vw, 1.15rem);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    opacity: 0.92;
  }

  /* ---------- Flecha ---------- */
  .hero__scroll {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: 1.4rem;
    transform: translateX(-50%);
    color: var(--h-cream);
    text-decoration: none;
    font-size: 1.4rem;
    opacity: 0.75;
    animation: hero-bob 2.4s ease-in-out infinite;
  }
  @keyframes hero-bob {
    0%, 100% { transform: translate(-50%, 0); }
    50%      { transform: translate(-50%, 6px); }
  }

  /* ---------- Tablet ---------- */
  @media (max-width: 1024px) {
    .hero__content {
      width: min(48%, 440px);
      margin-right: 4vw;
    }
    .hero__name { font-size: clamp(2.8rem, 6.4vw, 4rem); }
    .hero__amp  { font-size: clamp(2.2rem, 5vw, 3.2rem); }
  }

  /* ---------- Móvil ---------- */
  @media (max-width: 768px) {
    .hero {
      flex-direction: column;
      justify-content: flex-end;
      align-items: stretch;
    }

    .hero__bg {
      bottom: auto;
      height: 74svh;
      -webkit-mask-image: linear-gradient(to bottom, #000 60%, transparent 100%);
              mask-image: linear-gradient(to bottom, #000 60%, transparent 100%);
    }
    .hero__bg::after { display: none; }
    .hero__photo { object-position: 45% 40%; }

    /* "Nos casamos" arriba de la foto */
    .hero__eyebrow { display: none; }
    .hero__eyebrow-top {
      display: block;
      position: absolute;
      z-index: 2;
      top: 2.4rem;
      left: 0;
      right: 0;
      margin: 0;
      text-align: center;
      font-family: var(--h-sans);
      font-weight: 600;
      font-size: 0.72rem;
      letter-spacing: 0.34em;
      text-transform: uppercase;
      color: #fff;
      text-shadow: 0 1px 10px rgba(0, 0, 0, 0.35);
    }

    .hero__content {
      width: 100%;
      margin: 0;
      /* espacio abajo para el reproductor de música */
      padding: 0 1rem 6.2rem;
    }

    /* Una sola línea: Elizabeth & Jeremias */
    .hero__names {
      flex-direction: row;
      align-items: center;
      justify-content: center;
      gap: 0.28em;
      white-space: nowrap;
    }
    .hero__name { font-size: clamp(1.8rem, 8.2vw, 2.7rem); }
    .hero__amp {
      display: inline-block;
      font-size: clamp(2rem, 9vw, 3rem);
      margin-block: 0;
      line-height: 1;
    }

    .hero__date {
      margin-top: 1.1rem;
      font-weight: 600;
      font-size: 0.74rem;
      letter-spacing: 0.26em;
    }

    /* La flecha va a la izquierda para no chocar con el reproductor */
    .hero__scroll {
      left: 1.6rem;
      bottom: 1.5rem;
      animation: hero-bob-mobile 2.4s ease-in-out infinite;
    }
    @keyframes hero-bob-mobile {
      0%, 100% { transform: translateY(0); }
      50%      { transform: translateY(6px); }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__photo,
    .hero__scroll { animation: none; }
  }
</style>