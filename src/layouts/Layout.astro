---
export interface Props {
  title?: string;
  description?: string;
  guestName?: string;
}
const { title = 'Elizabeth & Jeremias', description = 'Te invitamos a compartir nuestro día más especial', guestName = 'Familia Torres' } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>

  <!-- Preconnect to Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- Fonts: Pinyon Script + Cinzel + Cormorant Garamond + Bodoni Moda + Josefin Sans -->
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;1,6..96,400&family=Cinzel:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Josefin+Sans:wght@300;400&family=Pinyon+Script&display=swap" rel="stylesheet" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <slot name="head" />
</head>
<body>
  <slot />

  <style is:global>
    /* =============================================
       TERRACOTA MUSE — Global Tokens & Reset
    ============================================= */
    :root {
      /* — Color palette — */
      --cream:        #f2eee6;
      --cream-warm:   #f7e6ca;
      --cream-light:  #fdf8f3;
      --terracota:    #9e4922;
      --terracota-mid:#c8805a;
      --terracota-lt: #da9d8a;
      --amber:        #db7c39;
      --gold:         #c28f2d;
      --gold-lt:      #e3c97a;
      --sage:         #768064;
      --sage-dk:      #525e2c;
      --sage-lt:      #b6bf9b;
      --olive:        #7b904b;
      --brown-dk:     #3d2b1f;
      --brown:        #665d3c;
      --text-dark:    #1c1a1a;
      --text-mid:     #4d4a4a;
      --text-light:   #756f6f;
      --white:        #ffffff;

      /* — Typography — */
      --font-display:  'Cinzel', serif;
      --font-script:   'Bodoni Moda', serif;
      --font-body:     'Cormorant Garamond', serif;
      --font-sans:     'Josefin Sans', sans-serif;

      /* — Spacing — */
      --section-pad:   clamp(4rem, 10vw, 9rem);
      --inner-max:     900px;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html {
      scroll-behavior: smooth;
      font-size: 16px;
    }

    body {
      background-color: var(--cream);
      color: var(--text-dark);
      font-family: var(--font-body);
      font-weight: 400;
      line-height: 1.7;
      overflow-x: hidden;
    }

    img { max-width: 100%; height: auto; display: block; }

    /* ── Utility ── */
    .container {
      width: min(100%, var(--inner-max));
      margin-inline: auto;
      padding-inline: 1.5rem;
    }

    .section-divider {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-block: 2rem;
      color: var(--gold);
    }
    .section-divider::before,
    .section-divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--gold), transparent);
    }

    /* ── Scroll-reveal animations ── */
    .reveal {
      opacity: 0;
      transform: translateY(32px);
      transition: opacity 0.85s cubic-bezier(.22,.68,0,1.2), transform 0.85s cubic-bezier(.22,.68,0,1.2);
    }
    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }
    .reveal-delay-1 { transition-delay: 0.15s; }
    .reveal-delay-2 { transition-delay: 0.30s; }
    .reveal-delay-3 { transition-delay: 0.45s; }
    .reveal-delay-4 { transition-delay: 0.60s; }
    .reveal-scale {
      opacity: 0;
      transform: scale(0.92);
      transition: opacity 0.9s ease, transform 0.9s cubic-bezier(.22,.68,0,1.2);
    }
    .reveal-scale.visible { opacity: 1; transform: scale(1); }

    /* ── Typography helpers ── */
    .title-display {
      font-family: var(--font-display);
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--terracota);
    }
    .title-script {
      font-family: var(--font-script);
      font-style: italic;
      font-weight: 400;
      color: var(--brown-dk);
    }
    .text-gold { color: var(--gold); }
    .text-sage  { color: var(--sage); }
    .text-terra { color: var(--terracota); }

    /* ── Thin ornament line ── */
    .ornament-line {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      justify-content: center;
      color: var(--gold);
      font-size: 0.75rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
    }
    .ornament-line::before,
    .ornament-line::after {
      content: '';
      width: 40px;
      height: 1px;
      background: var(--gold);
      opacity: 0.6;
    }

    /* ── Petal sparkle keyframe ── */
    @keyframes petal-float {
      0%   { transform: translateY(0) rotate(0deg); opacity: 0; }
      10%  { opacity: 1; }
      90%  { opacity: 0.6; }
      100% { transform: translateY(-100vh) rotate(360deg); opacity: 0; }
    }
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes shimmer {
      0%   { background-position: -200% center; }
      100% { background-position: 200% center; }
    }
    @keyframes pulse-soft {
      0%, 100% { opacity: 1; }
      50%       { opacity: 0.6; }
    }
  </style>
</body>
</html>
